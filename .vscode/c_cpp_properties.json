        "${workspaceFolder}/.venv/lib/python3.12/site-packages/nanobind/include",
        "/opt/homebrew/opt/python@3.12/Frameworks/Python.framework/Versions/3.12/include/python3.12"
      ],
      "defines": [
        "_METAL_",
        "ACCELERATE_NEW_LAPACK",
